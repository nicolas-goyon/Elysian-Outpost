<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- The Vulkan bindings use pointers to native structures (#35). -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ElysianOutpost.Core\ElysianOutpost.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Ahwoo.BRUTAL.Core" Version="2026.10.1" />
    <PackageReference Include="Ahwoo.BRUTAL.Glfw" Version="2026.10.4" />
    <!-- Dear ImGui and ImPlot for the debug overlay (#36). The backends package also brings Ahwoo.BRUTAL.OpenGl, which the app does not use. -->
    <PackageReference Include="Ahwoo.BRUTAL.ImGui" Version="2026.10.2" />
    <PackageReference Include="Ahwoo.BRUTAL.ImGui.Backends" Version="2026.10.2" />
    <PackageReference Include="Ahwoo.BRUTAL.ImPlot" Version="2026.10.2" />
    <PackageReference Include="Ahwoo.BRUTAL.Logging" Version="2026.10.2" />
    <!-- The shader compiler (shaderc) compiles the GLSL shaders of the chunk renderer at the start of the app (#39). -->
    <PackageReference Include="Ahwoo.BRUTAL.ShaderC" Version="2026.10.2" />
    <PackageReference Include="Ahwoo.BRUTAL.Vulkan" Version="2026.10.2" />
    <PackageReference Include="Ahwoo.BRUTAL.Vulkan.Abstractions" Version="2026.10.2" />
    <!-- The Vulkan Memory Allocator gives the memory of the chunk buffers and of the depth image (#39). -->
    <PackageReference Include="Ahwoo.BRUTAL.Vulkan.Vma" Version="2026.10.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- The GLSL sources of the shaders. ShaderCompiler reads them with the names ElysianOutpost.App.Shaders.<file name>. -->
    <EmbeddedResource Include="Shaders\*.vert;Shaders\*.frag" LogicalName="ElysianOutpost.App.Shaders.%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
