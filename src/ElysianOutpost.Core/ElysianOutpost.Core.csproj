<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Each public type and member has an XML comment (#17). TreatWarningsAsErrors makes CS1591 an error. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <WarningsAsErrors>$(WarningsAsErrors);CS1591</WarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Ahwoo.BRUTAL.Numerics" Version="2026.10.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- The tests use the internal test hooks, for example ChunkStreamer.MeshJobStarting (#47). -->
    <InternalsVisibleTo Include="ElysianOutpost.Core.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- The palette of the game (#2). BlockPalette.Game reads it. -->
    <EmbeddedResource Include="..\..\data\palette.json" LogicalName="ElysianOutpost.Core.Voxels.palette.json" Link="Voxels\palette.json" />
  </ItemGroup>

</Project>
